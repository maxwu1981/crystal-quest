  "npcs": [
    {
      "id": "granny",
      "name": "刘家阿婆",
      "sprite": "elder",
      "x": 5,
      "y": 8,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "我活到九十，看过那把火熄，也看过它着转来。",
            "这样够了。你们坐，我叫人打粄。"
          ]
        },
        {
          "unless": "gotHerb",
          "set": [
            "gotHerb"
          ],
          "give": {
            "items": [
              {
                "id": "antidote",
                "qty": 2
              },
              {
                "id": "eyedrop",
                "qty": 1
              }
            ]
          },
          "lines": [
            "细人仔的时候，我阿爸带我去恒春看过那把火。",
            "从石头缝里冒出来，一直烧，落大水也不熄。",
            "现在熄了。我活到九十，头一次听到这种事。",
            "这包草药你们揣着。中了毒、目珠花，都用得到。"
          ]
        },
        {
          "lines": [
            "这间伙房住过五代人。公厅的牌位，一个也没搬过。",
            "厝可以旧，火不能熄。"
          ]
        }
      ]
    },
    {
      "id": "ban_mother",
      "name": "打粄的阿姆",
      "sprite": "woman",
      "x": 11,
      "y": 8,
      "dir": "left",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "四个去，四个转来。我没算错。",
            "粄还热的，我天光又打了一笼。",
            "这回舂粄的人够了，三个都有。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "粄我多打一笼，你们转来的时候还热的。",
            "记得——四个人去，四个人转来。"
          ]
        },
        {
          "lines": [
            "打粄要三个人轮流舂，一个人打不动。",
            "米、火、力气，缺一样就不成粄。"
          ]
        }
      ]
    },
    {
      "id": "copy_kid",
      "name": "抄谱的细人仔",
      "sprite": "kid",
      "x": 11,
      "y": 3,
      "dir": "down",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "阿姆讲，这本不用添新的名了。",
            "我从头抄到尾，抄到第七个……",
            "那个名，族谱里翻不到。"
          ]
        },
        {
          "lines": [
            "阿公叫我把祖先的名字抄一百遍，说这样才记得住。",
            "我抄到第七十个的时候，我阿姆哭了。",
            "她说这本，这个月要添新的名。"
          ]
        }
      ]
    }
  ]
}
