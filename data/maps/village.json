  "npcs": [
    {
      "id": "guard",
      "name": "巡更的",
      "sprite": "guard",
      "x": 14,
      "y": 10,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "出火又着起来了！我昨暗看到的，烧得比以前还旺。",
            "庄里这几天总算睡得着觉。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "罗经圈就在庄北，过了万峦溪那条圳沟就是。",
            "那一带路弯来弯去，像罗盘一样绕，进去很容易迷路。",
            "天暗以前一定要出来，听到没有。"
          ]
        },
        {
          "lines": [
            "这几暗都有人讲，山脚那边有声音在叫他的名。",
            "要出庄的话，先去昌黎祠问阿伯，他知道的比我多。"
          ]
        }
      ]
    },
    {
      "id": "girl",
      "name": "阿妹",
      "sprite": "woman",
      "x": 10,
      "y": 16,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "我阿爸昨天自己走回来了。他说不记得这几天去哪了。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "你们真的要上大武山？……早点转来。",
            "我在庙口等你们。"
          ]
        },
        {
          "lines": [
            "我阿爸前天晚上出去就没转来了。",
            "庄里的人说，是被魔神仔牵走的……"
          ]
        }
      ]
    },
    {
      "id": "oldman",
      "name": "老庄民",
      "sprite": "man",
      "x": 21,
      "y": 16,
      "dir": "left",
      "dialogue": [
        {
          "lines": [
            "恒春那个「出火」，几百年没熄过。上个月熄了。",
            "老一辈讲，那把火是压着山内的东西的。火熄了，东西就出来了。",
            "你们进罗经圈，记得手上带火。不管什么火都好。"
          ]
        }
      ]
    },
    {
      "id": "kid",
      "name": "庄内囝仔",
      "sprite": "kid",
      "x": 18,
      "y": 12,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "lines": [
            "我阿公讲，被魔神仔牵去的人，回来嘴里都是牛屎和草。",
            "……阿公说这是真的，不是骗我的。"
          ]
        }
      ]
    }
  ]
