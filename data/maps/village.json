  "npcs": [
    {
      "id": "guard",
      "name": "卫兵",
      "sprite": "guard",
      "x": 14,
      "y": 10,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "光回来了！你们真的做到了。",
            "北边的洞窟里怪物少多了，不过别大意。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "村长把水晶的事托付给你们了？",
            "回音洞窟在北边草原的尽头。路上的怪物比以前凶得多，药水一定要带够。"
          ]
        },
        {
          "lines": [
            "北边的草原最近怪物很多，别乱跑。",
            "要出村的话，先去左上那间屋子听听村长怎么说吧。"
          ]
        }
      ]
    },
    {
      "id": "girl",
      "name": "少女",
      "sprite": "woman",
      "x": 10,
      "y": 16,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "昨晚的星星好亮……谢谢你们。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "你们真的要去洞窟？……一定要平安回来。"
          ]
        },
        {
          "lines": [
            "自从水晶的光消失以后，晚上连星星都变暗了。"
          ]
        }
      ]
    },
    {
      "id": "oldman",
      "name": "老人",
      "sprite": "man",
      "x": 21,
      "y": 16,
      "dir": "left",
      "dialogue": [
        {
          "lines": [
            "年轻时我也进过回音洞窟。",
            "在里面喊一声，能听见十次回声——所以千万别大声说话，会把怪物引来。"
          ]
        }
      ]
    },
    {
      "id": "kid",
      "name": "孩子",
      "sprite": "kid",
      "x": 18,
      "y": 12,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "lines": [
            "我长大了也要当战士！",
            "呐，你的剑能借我看看吗？……不行吗。"
          ]
        }
      ]
    }
