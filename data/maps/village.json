  "npcs": [
    {
      "id": "guard",
      "name": "守夜人",
      "sprite": "guard",
      "x": 14,
      "y": 10,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "颜色回来了……我昨晚数了一遍，全村的名字一个都不少。",
            "谢谢你们。真的。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "记名人把初响的事托付给你们了？",
            "失名窟在北边平原的尽头。越往里走越安静，安静到你会忘记自己叫什么。",
            "所以在里面——常常喊出同伴的名字。这是唯一的办法。"
          ]
        },
        {
          "lines": [
            "北边的平原褪得厉害，草的绿都快看不出来了。",
            "要出村的话，先去左上那间屋子，记名人有话跟你们说。"
          ]
        }
      ]
    },
    {
      "id": "girl",
      "name": "少女",
      "sprite": "woman",
      "x": 10,
      "y": 16,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "我又想起我姐姐的样子了。昨天还只记得一个影子。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "你们真的要去失名窟？……记得回来。",
            "回来的时候，我会喊你们的名字。"
          ]
        },
        {
          "lines": [
            "自从初响停了，晚上就再没有声音。",
            "连虫子都不叫了。安静得让人害怕。"
          ]
        }
      ]
    },
    {
      "id": "oldman",
      "name": "老人",
      "sprite": "man",
      "x": 21,
      "y": 16,
      "dir": "left",
      "dialogue": [
        {
          "lines": [
            "年轻时我进过失名窟。",
            "在里面喊一声，能听见十次回声——最后一次回来的，往往不是你自己的声音。",
            "那时候我丢了三天的记忆。所以，别在里面待太久。"
          ]
        }
      ]
    },
    {
      "id": "kid",
      "name": "孩子",
      "sprite": "kid",
      "x": 18,
      "y": 12,
      "dir": "down",
      "wander": true,
      "dialogue": [
        {
          "lines": [
            "我爹说我出生那天，初响响得特别亮。",
            "可是我现在想不起来他长什么样了……你说奇怪不奇怪？"
          ]
        }
      ]
    }
  ]
