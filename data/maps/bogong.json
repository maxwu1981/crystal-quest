  "npcs": [
    {
      "id": "bogong_granny",
      "name": "拜伯公的阿婆",
      "sprite": "woman",
      "x": 4,
      "y": 1,
      "dir": "down",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "铃还在吧？莫丢。伯公借你们的，要还的。",
            "……算了，你们留着。伯公不缺铃。"
          ]
        },
        {
          "unless": "gotBell",
          "set": [
            "gotBell"
          ],
          "give": {
            "items": [
              {
                "id": "bell",
                "qty": 1
              }
            ]
          },
          "lines": [
            "伯公是这庄的当家，田头田尾都是他在顾。",
            "这只铃你们带着。",
            "在山里听到有人叫你的名——先摇铃，再回头。"
          ]
        },
        {
          "lines": [
            "魔神仔怕响，不怕人。",
            "所以我们敲锣、摇铃、放炮。吵一点，它就绕路走。"
          ]
        }
      ]
    },
    {
      "id": "bogong_keeper",
      "name": "顾庙的阿伯",
      "sprite": "elder",
      "x": 7,
      "y": 4,
      "dir": "left",
      "dialogue": [
        {
          "if": [
            "bossDefeated",
            "altar2"
          ],
          "unless": "altar3",
          "set": [
            "altar3"
          ],
          "give": {
            "items": [
              {
                "id": "gram",
                "qty": 1
              }
            ]
          },
          "lines": [
            "火种转来了，土就毋会裂了。最后这件，是自家滚出来的。",
            "一把剑。断过又接起来，接口还看得出。",
            "伯公的意思大概係——账还清了，东西还你们。"
          ]
        },
        {
          "if": "altar1",
          "unless": "altar2",
          "set": [
            "altar2"
          ],
          "give": {
            "items": [
              {
                "id": "zulfiqar",
                "qty": 1
              }
            ]
          },
          "lines": [
            "又吐一件出来。这摆係刀，刀尖分两叉。",
            "𠊎阿公讲过，早年渡海过来的毋单净客家人。",
            "有兜人上了岸，东西留下来，人无留下来。"
          ]
        },
        {
          "if": "questStarted",
          "unless": "altar1",
          "set": [
            "altar1"
          ],
          "give": {
            "items": [
              {
                "id": "was_scepter",
                "qty": 1
              }
            ]
          },
          "lines": [
            "红纸压毋核。今朝掀开看，缝里吐出这个。",
            "一支杖，杖头係只狗，耳公竖到直直。",
            "伯公坛下背埋个东西，比这庄还较老。你们拿去，路上用得着。"
          ]
        },
        {
          "if": "bossDefeated",
          "lines": [
            "那条缝合起来了。红纸𠊎今早撕掉了。",
            "土是温的，跟以前一样。"
          ]
        },
        {
          "lines": [
            "伯公坛前的土，昨暗自己裂了一条缝。",
            "𠊎用红纸压住了。你们看——纸还在跳。"
          ]
        }
      ]
    }
  ]
}
