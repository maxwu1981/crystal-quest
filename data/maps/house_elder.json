  "npcs": [
    {
      "id": "elder",
      "name": "庙祝阿伯",
      "sprite": "elder",
      "x": 5,
      "y": 3,
      "dir": "down",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "火种放回去了，出火又着起来了。",
            "那个「乌火」讲的还有别的地缝……我再翻翻族谱。你们先歇。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "罗经圈在庄北，过了圳沟就是。绕过去就是大武山的山脚。",
            "走不动就转来，庙门我不关。",
            "打不过就在选单里「转职」——你们身上不只一种功夫。"
          ]
        },
        {
          "set": [
            "questStarted",
            "jobUnlocked"
          ],
          "give": {
            "gold": 100
          },
          "lines": [
            "来了啊。坐，我讲慢一点。",
            "恒春那个「出火」，地底冒出来的火，三百年没熄过。上个月，熄了。",
            "六堆的老册子上写：那把火，是先民留下来压山的。火在，山内的东西就出不来。",
            "火熄的第三暗，庄里开始有人被牵走。走的时候都笑咪咪的，跟着谁在讲话。",
            "我这本册子，这个月已经记了七个名。",
            "你们四个是庄里脚手最俐落的。上大武山，把火种带转来。",
            "这是庄里凑的一百箍。还有这个——「六堆的令旗」，握着它，你们会想起自己还能是什么人。",
            "在选单里选「转职」就知了。去吧，先去杂货铺买些物件。"
          ]
        }
      ]
    }
  ]
