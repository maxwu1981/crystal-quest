  "npcs": [
    {
      "id": "elder",
      "name": "庙祝阿伯",
      "sprite": "elder",
      "x": 6,
      "y": 2,
      "dir": "down",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "火种放回去了，出火又着起来了。",
            "那个「乌火」讲的还有别的地缝……我再翻翻族谱。你们先歇。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "罗经圈在庄北，过了圳沟就是。绕过去就是大武山的山脚。",
            "走不动就转来，庙门我不关。",
            "打不过就在选单里「转职」——你们身上不只一种功夫。"
          ]
        },
        {
          "set": [
            "questStarted",
            "jobUnlocked"
          ],
          "give": {
            "gold": 100
          },
          "lines": [
            "来了啊。坐，我讲慢一点。",
            "恒春那个「出火」，地底冒出来的火，三百年没熄过。上个月，熄了。",
            "六堆的老册子上写：那把火，是先民留下来压山的。",
            "火在，山内的东西就出不来。",
            "火熄的第三暗，庄里开始有人被牵走。",
            "走的时候都笑咪咪的，跟着谁在讲话。",
            "我这本册子，这个月已经记了七个名。",
            "你们四个是庄里脚手最俐落的。上大武山，把火种带转来。",
            "这是庄里凑的一百箍。还有这个——「六堆令旗」。",
            "握着它，你们会想起自己还能是什么人。",
            "在选单里选「转职」就知了。去吧，先去杂货铺买些物件。"
          ]
        }
      ]
    },
    {
      "id": "poe",
      "name": "问事的阿婆",
      "sprite": "woman",
      "x": 10,
      "y": 8,
      "dir": "left",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "我替庄里跋了一杯，问这事过了没。",
            "笑杯。神明又在笑了。",
            "这次我不敢讲我心内的答案。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "我替你们跋了一杯。圣杯。",
            "神明点头了，那就是能行。剩下的看你们的脚。"
          ]
        },
        {
          "lines": [
            "我跋了三次都是笑杯。神明在笑，不是不给。",
            "笑杯的意思是：这件事你心内早就知答案了。"
          ]
        }
      ]
    },
    {
      "id": "incense",
      "name": "顾香的细人仔",
      "sprite": "kid",
      "x": 3,
      "y": 8,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "这几日转来的人都来上香。",
            "我一直添，添到手酸。",
            "这次我是笑着酸的。"
          ]
        },
        {
          "lines": [
            "阿伯讲香不能断。断了，庙就暗了。",
            "我两个时辰添一次，添到手会酸。",
            "但是我不敢停。"
          ]
        }
      ]
    }
  ]
}
