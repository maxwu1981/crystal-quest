 "npcs": [
  {
   "id": "lost_hunter",
   "name": "绕不出去的猎人",
   "sprite": "man",
   "x": 13,
   "y": 18,
   "dir": "left",
   "dialogue": [
    {
     "if": "gameCleared",
     "lines": [
      "山内有味了。烟味。𠊎闻得出方向。",
      "𠊎行得出去了。下摆换𠊎去寻那只老山猪。"
     ]
    },
    {
     "unless": "metHunter",
     "set": [
      "metHunter"
     ],
     "lines": [
      "细声一点。在这个圈里，莫喊自己人的名。",
      "𠊎昨暗喊过一声，真的有人应。声音不是𠊎认得的。",
      "𠊎跟着一只老山猪入来。阿公打过它，阿爸打过它，𠊎也打过。",
      "三代人打过，三代人都没打死。脚印行到水边就断了。",
      "你们若遇到山猪，往下坡跑。它的脚短，下坡追不上人。"
     ]
    },
    {
     "lines": [
      "庄里人讲，跟着水声行就不会绕。",
      "𠊎试过了。水声也会绕。"
     ]
    }
   ]
  }
