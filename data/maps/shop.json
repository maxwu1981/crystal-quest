          "linen_robe",
          "silk_robe",
          "copper_ring",
          "silver_ring",
          "power_band",
          "guard_band"
        ]
      },
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "转来啦！我册子上你们四个的名，今日划掉了。",
            "要什么自己看，价钱照旧，我不哄人。"
          ]
        },
        {
          "if": "questStarted",
          "lines": [
            "阿伯讲的我听说了。要上山的，药仔多带一点。",
            "打的物件坏了可以再买，人坏了买不到。"
          ]
        },
        {
          "lines": [
            "入来看看。青草、符仔、家私，我这都有。",
            "要上山的话，药仔多带一点，不骗你。"
          ]
        }
      ]
    },
    {
      "id": "shop_daughter",
      "name": "顾店的细妹",
      "sprite": "woman",
      "x": 11,
      "y": 5,
      "dir": "left",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "我阿爸昨暗划了一晚上的勾。",
            "你们四个的名，划得最用力。",
            "只剩一个名没勾。那人比你们先上山。"
          ]
        },
        {
          "lines": [
            "我阿爸算钱很慢，你们莫笑他。",
            "他把每个上山的人都记在册子上，写谁转来了。",
            "这两页，都还没画勾。"
          ]
        }
      ]
    },
    {
      "id": "incense_buyer",
      "name": "来买香的阿婶",
      "sprite": "elder",
      "x": 2,
      "y": 5,
      "dir": "right",
      "dialogue": [
        {
          "if": "gameCleared",
          "lines": [
            "香还是缺货，不过这回是谢神用的。",
            "怕的时候买，跟还愿的时候买，价钱一样。",
            "心情差很多。"
          ]
        },
        {
          "lines": [
            "香、金纸、盐米，这几日卖到缺货。",
            "大家怕，就多买一点。好像买了就安心。"
          ]
        }
      ]
    }
  ]
